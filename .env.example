# NEXUS runtime
NEXUS_ENV=development
NEXUS_FREE_ONLY=true
NEXUS_BACKGROUND_EXECUTION=false
NEXUS_LOG_LEVEL=INFO

# Backend
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000

# Database
NEXUS_DATABASE_URL=sqlite:///./nexus.db

# Optional local model gateway
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional AI provider credentials.
# Never commit real values to Git.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# PERPLEXITY_API_KEY=
# DEEPSEEK_API_KEY=
